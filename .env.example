# Gmail address local part only; do not include @gmail.com.
# Example: for qa.automation@gmail.com, use qa.automation
baseEmail=your_gmail_username

# Recommended for CI: OAuth 2.0 credentials used to refresh the access token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional local fallback. Access tokens expire quickly, so leave this empty
# when the refresh-token credentials above are configured.
GMAIL_ACCESS_TOKEN=
